# Lumio Agency – tryb "strona w budowie" (cyber_Folks / Apache, LiteSpeed)
#
# Każdy adres (poza plikami z /assets/) pokazuje index.html z kodem 503
# + Retry-After, więc Google nie zaindeksuje strony tymczasowej
# i nie "zapomni" domeny.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + bez www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lumioagency.pl%{REQUEST_URI} [L,R=301]

  # Twoje IP widzi zwykłą stronę (odkomentuj i wpisz swoje IP)
  # RewriteCond %{REMOTE_ADDR} !^123\.45\.67\.89$

  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteRule ^ - [R=503,L]
</IfModule>

ErrorDocument 503 /index.html

<IfModule mod_headers.c>
  Header always set Retry-After "86400" "expr=%{REQUEST_STATUS} == 503"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
